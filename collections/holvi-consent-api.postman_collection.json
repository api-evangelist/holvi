                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "code",
                  "description": "(Required) Authorization code from the login redirect (token_uuid)."
                }
              ]
            },
            "header": [
